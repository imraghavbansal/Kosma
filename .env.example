# Copy this file to .env and adjust as needed. Never commit the real .env.

ENVIRONMENT=local

# Supabase Postgres connection string. Create a free project at supabase.com,
# then Project Settings -> Database -> Connection string (use the "Session
# pooler" URI, port 5432 or 6543 depending on your project). pgvector is
# pre-enabled on Supabase - no local Postgres/Docker needed for V1.
DATABASE_URL=postgresql+psycopg://postgres:your-password@db.your-project.supabase.co:5432/postgres

# Dashboard login (single shared secret for V1 - see docs/architecture.md)
KOSMA_DASHBOARD_SECRET=change-me
KOSMA_SESSION_SECRET_KEY=change-me-session-signing-key

# AI provider mode - "mock" is the only mode exercised in V1
AI_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Where the Next.js server proxies /api/* to.
API_INTERNAL_URL=http://localhost:8000

# GitHub OAuth (optional second login method, see kosma_api/routers/oauth.py).
# Create an OAuth App at github.com/settings/developers. The callback URL
# must be your FRONTEND's proxied path (not the API's own domain), e.g.
# https://your-app.vercel.app/api/v1/auth/github/callback - the Next.js
# rewrite is what keeps the session cookie on the frontend's origin.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/auth/github/callback
FRONTEND_URL=http://localhost:3000
